{
  "name": "iya-oloja",
  "description": "Nigerian Markets API — an open directory of markets across Nigeria",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler pages deploy dist --project-name iya-oloja --branch main",
    "seed": "pnpm exec tsx scripts/seed-states.ts",
    "validate": "pnpm exec tsx scripts/validate-data.ts",
    "sync": "pnpm exec tsx scripts/sync-to-d1.ts",
    "import:grid3": "pnpm exec tsx scripts/import-grid3-markets.ts",
    "db:migrate": "wrangler d1 execute iya-oloja --local --file=migrations/0001_create_tables.sql"
  },
  "dependencies": {
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.26.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.2",
    "vite": "^6.4.3",
    "wrangler": "^4.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"],
    "overrides": {
      "dompurify": "^3.4.11",
      "protobufjs": "^7.6.3",
      "@protobufjs/utf8": "^1.1.1",
      "shell-quote": "^1.8.4",
      "fast-uri": "^3.1.2",
      "fast-xml-parser": "^5.7.0",
      "fast-xml-builder": "^1.1.7",
      "postcss": "^8.5.10",
      "js-yaml": "^4.2.0",
      "ts-deepmerge": "^8.0.0",
      "@opentelemetry/core": "^2.8.0",
      "@hono/node-server": "^1.19.13",
      "undici": "^6.27.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1"
    }
  }
}
